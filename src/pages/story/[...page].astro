---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Shell from "@/layouts/Shell.astro";
import Pagination from "@/components/Pagination.astro";
import StoryCard from "@/components/StoryCard.astro";
import getSortedStories from "@/utils/getSortedStories";
import { getStoryTitle } from "@/utils/getStoryPath";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";

export const getStaticPaths = (async ({ paginate }) => {
  const stories = await getCollection("story", ({ data }) => !data.draft);
  return paginate(getSortedStories(stories), { pageSize: 18 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// 右侧目录：这一页展示的每一期图文，锚点由 StoryCard 落到卡片上
const outlineItems = page.data.map((story, index) => ({
  id: `story-${index + 1}`,
  label: getStoryTitle(story.data.title, story.id, story.filePath),
}));
const anchors = page.data.map((story, index) => ({
  story,
  anchor: `story-${index + 1}`,
}));
---

<Shell
  title={`${UI.pages.storiesTitle} | ${SITE.title}`}
  pageTitle={UI.pages.storiesTitle}
  outline={{ label: UI.pages.storiesTitle, items: outlineItems }}
>
  <ul class="story-wall grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {anchors.map(({ story, anchor }) => (
      <StoryCard {...story} {anchor} />
    ))}
  </ul>
  <Pagination {page} />
</Shell>

<script is:inline>
  (() => {
    let observer = null;

    const loadVideoMeta = video => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (video.dataset.storyMetaLoaded === "true") return;

      video.dataset.storyMetaLoaded = "true";
      video.preload = "metadata";
      if (video.readyState < 1) {
        try {
          video.load();
        } catch {
          // ignore
        }
      }
      if (observer) observer.unobserve(video);
    };

    const initStoryWallVideoLazyLoad = () => {
      if (observer) {
        observer.disconnect();
        observer = null;
      }

      const videos = Array.from(
        document.querySelectorAll("video[data-story-card-video]")
      ).filter(node => node instanceof HTMLVideoElement);
      if (videos.length === 0) return;

      const eagerCount = window.matchMedia("(max-width: 640px)").matches ? 2 : 4;
      videos.slice(0, eagerCount).forEach(loadVideoMeta);

      if (!("IntersectionObserver" in window)) {
        videos.slice(eagerCount).forEach(loadVideoMeta);
        return;
      }

      observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            loadVideoMeta(entry.target);
          });
        },
        {
          root: null,
          rootMargin: "260px 0px",
          threshold: 0.01,
        }
      );

      videos.slice(eagerCount).forEach(video => observer.observe(video));
    };

    document.addEventListener("astro:page-load", initStoryWallVideoLazyLoad);
    document.addEventListener("astro:before-preparation", () => {
      if (observer) {
        observer.disconnect();
        observer = null;
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initStoryWallVideoLazyLoad, {
        once: true,
      });
    } else {
      initStoryWallVideoLazyLoad();
    }
  })();
</script>
