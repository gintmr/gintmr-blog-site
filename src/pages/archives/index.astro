---
/**
 * Top —— 置顶文章页。
 *
 * 这里只渲染被置顶的条目（frontmatter 里 featured: true，或 pubDatetime 写成 "top"）。
 * 完整时间线在 /blog：同一份取数逻辑，只是那边不按置顶筛选，
 * 置顶文章会回到它自己日期所在的位置。
 */
import Shell from "@/layouts/Shell.astro";
import ArchiveEntry from "@/components/ArchiveEntry.astro";
import { getArchiveItems, sortByTimeline } from "@/utils/archiveItems";
import { SITE } from "@/config";
import { UI, UI_LOCALE } from "@/i18n/ui";

if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const pinned = sortByTimeline((await getArchiveItems()).filter(item => item.pinned));

// 锚点与右侧目录共用同一份顺序，保证目录点得动
const anchored = pinned.map((item, index) => ({
  item,
  anchor: `top-${index + 1}`,
}));

const pageDesc =
  UI_LOCALE === "zh-CN"
    ? "我挑出来放在最前面的几篇。"
    : "A short set of pieces I keep at the front.";

const emptyText =
  UI_LOCALE === "zh-CN" ? "还没有置顶文章。" : "Nothing pinned yet.";
const emptyHint =
  UI_LOCALE === "zh-CN"
    ? "看完整体时间线请去"
    : "See the full timeline in";

const outlineLabel = UI.nav.top;

// 右侧目录用的条目：有置顶就是这几篇，一篇都没有时指向空态那一块
const outlineItems =
  anchored.length > 0
    ? anchored.map(({ item, anchor }) => ({ id: anchor, label: item.title }))
    : [{ id: "top-empty", label: UI.nav.top }];
---

<Shell
  title={`${UI.nav.top} | ${SITE.title}`}
  pageTitle={UI.nav.top}
  pageDesc={pageDesc}
  outline={{ label: outlineLabel, items: outlineItems }}
>
  {
    anchored.length > 0 ? (
      <ul class="space-y-4">
        {anchored.map(({ item, anchor }) => (
          <ArchiveEntry {item} {anchor} showPinnedChip={false} />
        ))}
      </ul>
    ) : (
      <section class="subtle-page-note px-0" id="top-empty">
        <div class="subtle-page-note__label">{emptyText}</div>
        <p class="mt-2">
          {emptyHint} <a href="/blog">{UI.nav.blog}</a>
        </p>
      </section>
    )
  }
</Shell>
