---
import Shell from "@/layouts/Shell.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";
---

<Shell
  title={`404 Not Found | ${SITE.title}`}
  breadcrumb={false}
  outline={false}
>
  <div class="mb-14 flex flex-col items-center justify-center py-16">
    <h1 class="text-9xl font-bold text-accent">404</h1>
    <span aria-hidden="true">¯\_(ツ)_/¯</span>
    <p class="mt-4 text-2xl sm:text-3xl">{UI.pages.notFound}</p>
    <LinkButton
      href="/"
      class="my-6 text-lg underline decoration-dashed underline-offset-8"
    >
      {UI.pages.goHome}
    </LinkButton>
  </div>
</Shell>
