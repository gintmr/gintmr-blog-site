---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_GOOGLE_ANALYTICS_ID } from "astro:env/client";
import { SITE } from "@/config";
import themePreload from "../../vendor/gintmr-ui/src/primitives/theme-preload.js?raw";
import { UI_COLORS, UI_EFFECTS, UI_FONTS, UI_THEME } from "@/ui.config";
import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** 内容列宽。所有页面共用同一套取值，左右两栏才不会在换页时跳位。 */
  pageWidth?: "standard" | "wide";
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  pageWidth = "standard",
} = Astro.props;

// 内容列宽：只有两档，全站共用，页面之间不出现第三个数。
// 实际取值写在 global.css 的 :root 规则里（那里能保证排在库的令牌之后），
// 这里只负责把档位挂到 <html> 上。
const pageWidthValue = pageWidth;

const socialImageURL = new URL(ogImage, Astro.url);
const faviconURL = `/${SITE.favicon}?v=${SITE.faviconVersion}`;
const designTokenCss = `
  :root {
    --site-font-sans: ${UI_FONTS.sans};
    --site-font-serif: ${UI_FONTS.serif};
    --site-font-display: ${UI_FONTS.display};
    --site-font-mono: ${UI_FONTS.mono};
    --site-light-background: ${UI_COLORS.light.background};
    --site-light-foreground: ${UI_COLORS.light.foreground};
    --site-light-accent: ${UI_COLORS.light.accent};
    --site-light-muted: ${UI_COLORS.light.muted};
    --site-light-border: ${UI_COLORS.light.border};
    --site-dark-background: ${UI_COLORS.dark.background};
    --site-dark-foreground: ${UI_COLORS.dark.foreground};
    --site-dark-accent: ${UI_COLORS.dark.accent};
    --site-dark-muted: ${UI_COLORS.dark.muted};
    --site-dark-border: ${UI_COLORS.dark.border};
    --site-image-neon-glow: ${UI_COLORS.imageNeonGlow};
    --site-image-neon-c1: ${UI_COLORS.imageNeonGradient.c1};
    --site-image-neon-c2: ${UI_COLORS.imageNeonGradient.c2};
    --site-image-neon-c3: ${UI_COLORS.imageNeonGradient.c3};
    --site-image-neon-c4: ${UI_COLORS.imageNeonGradient.c4};
    --site-ai-summary-border: ${UI_COLORS.aiSummary.border};
    --site-ai-summary-bg-from: ${UI_COLORS.aiSummary.bgFrom};
    --site-ai-summary-bg-via: ${UI_COLORS.aiSummary.bgVia};
    --site-ai-summary-bg-to: ${UI_COLORS.aiSummary.bgTo};
    --site-ai-summary-title-from: ${UI_COLORS.aiSummary.titleFrom};
    --site-ai-summary-title-to: ${UI_COLORS.aiSummary.titleTo};
    --site-ai-summary-star-from: ${UI_COLORS.aiSummary.starFrom};
    --site-ai-summary-star-to: ${UI_COLORS.aiSummary.starTo};
    --site-ai-summary-selection-bg: ${UI_COLORS.aiSummary.selectionBg};
    --site-surface-border: color-mix(in srgb, var(--border) 58%, transparent);
    --site-surface-bg: linear-gradient(
      180deg,
      color-mix(in srgb, var(--background) 80%, transparent),
      color-mix(in srgb, var(--background) 58%, transparent)
    );
    --site-surface-bg-strong: linear-gradient(
      180deg,
      color-mix(in srgb, var(--background) 90%, transparent),
      color-mix(in srgb, var(--background) 72%, transparent)
    );
    --site-surface-highlight: linear-gradient(
      180deg,
      color-mix(in srgb, white 4%, transparent) 0%,
      transparent 100%
    );
    --site-surface-shadow:
      0 18px 38px -30px color-mix(in srgb, black 84%, transparent),
      inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
  }
`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};

const currentPath = Astro.url.pathname;
// 所有页面共用同一套导航与转场：不再按「重媒体页」分叉。
// 分叉会让同样的点击在不同页面表现不一致（有的整页刷新、有的软跳转），
// 而且软跳转那一侧还会丢掉脚本写在 <html> 上的标记（主题、js 标记）。
const enableClientRouter = true;
const enablePageTransition = UI_EFFECTS.pageTransition;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
  data-force-dark={UI_THEME.forceDarkMode ? "true" : "false"}
  data-theme={UI_THEME.forceDarkMode ? "dark" : undefined}
  data-gintmr_ui-page-width={pageWidthValue}
  data-effect-page-transition={enablePageTransition ? "on" : "off"}
  data-gintmr_ui-effects={UI_EFFECTS.ambientGlow ? "on" : "off"}
  data-gintmr_ui-grid={UI_EFFECTS.gridOverlay ? "on" : "off"}
  data-gintmr_ui-aurora={UI_EFFECTS.auroraRibbon ? "on" : "off"}
  data-gintmr_ui-beam={UI_EFFECTS.headingBeam ? "on" : "off"}
  data-gintmr_ui-cursor={UI_EFFECTS.cursorGlow ? "on" : "off"}
>
  <head>
    <!-- 组件库的防闪烁片段：必须在任何样式表之前内联，否则主题会闪一下。
         data-astro-rerun 是必需的：客户端路由换页时 Astro 会把 <html> 的属性
         同步成新文档那一份，脚本写上去的 data-gintmr_ui-theme（主题）与
         data-gintmr_ui-js（顶栏工具按钮的显示开关）都会被抹掉，
         中间那段新页面就会掉成浅色、顶栏右侧图标消失。标上 rerun 让这段
         在每次换页时重跑，主题与开关在新页面绘制之前就落回去。 -->
    <script is:inline data-astro-rerun set:html={themePreload}></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={faviconURL} />
    <link rel="shortcut icon" type="image/png" href={faviconURL} />
    <link rel="apple-touch-icon" href={faviconURL} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    {
      // If PUBLIC_GOOGLE_ANALYTICS_ID is set in the environment variable,
      // include Google Analytics gtag.js
      PUBLIC_GOOGLE_ANALYTICS_ID && (
        <>
          <!-- Google tag (gtag.js) -->
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${PUBLIC_GOOGLE_ANALYTICS_ID}`}></script>
          <script is:inline define:vars={{ gaId: PUBLIC_GOOGLE_ANALYTICS_ID }}>
             window.dataLayer = window.dataLayer || [];
             /* eslint-disable prefer-rest-params */
             function gtag(){dataLayer.push(arguments);}
             /* eslint-enable prefer-rest-params */
             gtag('js', new Date());
             gtag('config', gaId);
           </script>
        </>
      )
    }

    {enableClientRouter && <ClientRouter />}

    <script is:inline src="/app-controls.js"></script>
    <script is:inline src="/site-effects.js"></script>
    <script>
      // 共用组件库。它自己会在 DOM 就绪时启动一次；
      // 这里负责在客户端路由换页的每个阶段让它重新初始化新插入的 DOM。
      // astro:after-swap 早于新页面绘制，先跑一遍才不会掉主题；
      // astro:page-load 晚于岛的 hydration，用来兜住之后才出现的元素。
      import { refresh } from "../../vendor/gintmr-ui/src/index.js";
      document.addEventListener("astro:after-swap", refresh);
      document.addEventListener("astro:page-load", refresh);
      document.addEventListener("post:decrypted", refresh);
    </script>
    <style is:inline set:html={designTokenCss}></style>
  </head>
  <body
    data-site-watermark="Gintmr"
    data-gintmr_ui-watermark="Gintmr"
    data-effect-ambient={UI_EFFECTS.ambientGlow ? "on" : "off"}
    data-effect-grid={UI_EFFECTS.gridOverlay ? "on" : "off"}
    data-effect-cursor={UI_EFFECTS.cursorGlow ? "on" : "off"}
    data-effect-reveal={UI_EFFECTS.revealOnScroll ? "on" : "off"}
    data-effect-card-glow={UI_EFFECTS.cardHoverGlow ? "on" : "off"}
    data-effect-nav-glass={UI_EFFECTS.navGlass ? "on" : "off"}
    data-effect-heading-beam={UI_EFFECTS.headingBeam ? "on" : "off"}
    data-effect-image-lift={UI_EFFECTS.imageLift ? "on" : "off"}
  >
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
