---
/**
 * 关于页：内容和其它页面一样走 Shell，只多一层 Profile 说明。
 * 保留这个文件是为了 .mdx 的 frontmatter layout 指向不变。
 */
import Shell from "./Shell.astro";
import { SITE } from "@/config";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Shell
  title={`${frontmatter.title} | ${SITE.title}`}
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  outline={{ headings: "#about :is(h2,h3,h4)" }}
>
  <section id="about" class="app-prose about-prose prose-img:border-0">
    <slot />
  </section>
</Shell>
