---
/**
 * 首页好词佳句。外观与「换一句」的行为都来自 vendor/gintmr-ui：
 * 左侧一条强调竖线 + 引文本身，颜色全部走调色板令牌，明暗主题自动成立。
 * 这里只负责把引语池传进去。
 */
import { UI_LOCALE } from "@/i18n/ui";
import { SPOTLIGHT_QUOTES } from "@/content/quoteSpotlight";

const label = UI_LOCALE === "zh-CN" ? "好词佳句" : "Spotlight";
const shuffleLabel = UI_LOCALE === "zh-CN" ? "换一句" : "Shuffle";
// 无 JS 时先显示第一句，脚本会换成随机会话里的那一句
const first = SPOTLIGHT_QUOTES[0] ?? { text: "", source: "" };
---

<figure class="gintmr_ui-quote" data-gintmr_ui-quote aria-label={label}>
  <blockquote class="gintmr_ui-quote__text" data-gintmr_ui-quote-text>{first.text}</blockquote>
  <figcaption class="gintmr_ui-quote__source" data-gintmr_ui-quote-source>{first.source}</figcaption>
  <button class="gintmr_ui-quote__shuffle" type="button" data-gintmr_ui-quote-shuffle aria-label={shuffleLabel}>
    <span aria-hidden="true">↻</span>
    <span>{shuffleLabel}</span>
  </button>
  <script
    type="application/json"
    data-gintmr_ui-quote-data
    set:html={JSON.stringify({ quotes: SPOTLIGHT_QUOTES })}
  ></script>
</figure>
