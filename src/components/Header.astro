---
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconMenu from "@/assets/icons/IconMenuDeep.svg";
import IconClose from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { UI } from "@/i18n/ui";

const { pathname } = Astro.url;
const faviconURL = `/${SITE.favicon}?v=${SITE.faviconVersion}`;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// 导航项：Top = 置顶文章页（/archives 现在只渲染置顶文章），
// Blog = 完整时间线（全部文章按年月排，置顶文章回到它自己的时间轴位置）。
const navItems = [
  { href: "/archives", label: UI.nav.top, match: "/archives" },
  { href: "/blog", label: UI.nav.blog, match: "/blog" },
  { href: "/story", label: UI.nav.stories, match: "/story" },
  { href: "/about", label: UI.nav.about, match: "/about" },
  { href: "/links", label: UI.nav.links, match: "/links" },
];
---

<!-- 悬浮玻璃面板：品牌、导航、工具按钮聚成一体，收成内容宽并居中，重模糊 + 高光边的圆角面板。
     组件与交互由 vendor/gintmr-ui 提供。 -->
<header class="gintmr_ui-header gintmr_ui-header--cluster gintmr_ui-header--floating">
  <div class="gintmr_ui-nav-container">
    <div class="gintmr_ui-header-shell">
      <a href="/" class="gintmr_ui-brand" aria-label={SITE.title}>
        <img
          src={faviconURL}
          alt=""
          width="40"
          height="40"
          class="gintmr_ui-brand-mark"
        />
        <span>{SITE.title}</span>
      </a>

      <nav
        id="site-nav"
        class="gintmr_ui-nav"
        aria-label="Main navigation"
        data-gintmr_ui-open="false"
      >
        {
          navItems.map(item => (
            <a
              href={item.href}
              aria-current={isActive(item.match) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="gintmr_ui-controls">
        <button
          class="gintmr_ui-theme-toggle"
          type="button"
          aria-label="Switch to light theme"
        >
          <svg
            class="gintmr_ui-icon gintmr_ui-icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
            ></path></svg
          >
          <svg
            class="gintmr_ui-icon gintmr_ui-icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M20 14.4A8.5 8.5 0 0 1 9.6 4a8.5 8.5 0 1 0 10.4 10.4Z"></path></svg
          >
        </button>
        {
          SITE.showArchives && (
            <LinkButton
              href="/blog"
              ariaLabel="archives"
              title="Archives"
            >
              <IconArchive class="gintmr_ui-icon" />
            </LinkButton>
          )
        }
        <LinkButton
          href="/search"
          ariaLabel="search"
          title="Search"
        >
          <IconSearch class="gintmr_ui-icon" />
        </LinkButton>
        <button
          id="menu-toggle"
          class="gintmr_ui-menu-toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <IconMenu class="gintmr_ui-icon gintmr_ui-icon-menu" />
          <IconClose class="gintmr_ui-icon gintmr_ui-icon-close" />
        </button>
      </div>
    </div>
  </div>
</header>
